{
  "name": "crafty-central",
  "version": "1.2.1",
  "private": true,
  "description": "The all-in-one hub for Crafty — jobs, calendar, crew, chat, and invoicing.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types db/seed.ts",
    "db:owner": "node --env-file-if-exists=.env --experimental-strip-types db/make-owner.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "mysql2": "3.24.3",
    "next": "16.3.3",
    "pdfkit": "0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
