# ---------------------------------------------------------------
# Crafty Central — copy to .env and fill in.
# Never commit .env; it is gitignored and, on the server,
# survives every deploy and rollback.
# ---------------------------------------------------------------

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=crafty
DB_PASSWORD=
DB_NAME=crafty_central

# Optional: a single URL instead of the pieces above.
# Takes precedence when set.
# DATABASE_URL=mysql://user:password@host:3306/crafty_central

# Session cookie signing. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 the first time you want /api/auth/signup to mint an admin
# for the very first account. Leave unset afterwards.
# ALLOW_FIRST_ADMIN=1
